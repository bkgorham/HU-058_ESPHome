# Copy to secrets.yaml before building. Choose your own passwords.

# Setup hotspot password (8–63 characters). Enter your home Wi-Fi credentials in the setup portal.
ap_password: "replace-with-setup-password"

# Password used by ESPHome for over-the-air firmware uploads.
ota_password: "clockupdate"

# Initial website login. Change it in Administration after setup.
web_username: "clock"
web_password: "clockadmin"

# Initial timezone. Change it in Administration after setup.
timezone: "America/New_York"
